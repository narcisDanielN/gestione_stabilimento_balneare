\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {Esplora Spiagge - Desktop (UC-04):} interfaccia desktop per la ricerca nel catalogo. La vista interroga in sola lettura (CQRS tramite la \texttt  {BeachCatalogQuery}) il database, mostrando esclusivamente le spiagge in stato \textit  {ATTIVO} ed esponendo la valutazione media.}}{22}{figure.caption.16}\protected@file@percent }
\newlabel{fig:mockup1}{{14}{22}{\textbf {Esplora Spiagge - Desktop (UC-04):} interfaccia desktop per la ricerca nel catalogo. La vista interroga in sola lettura (CQRS tramite la \texttt {BeachCatalogQuery}) il database, mostrando esclusivamente le spiagge in stato \textit {ATTIVO} ed esponendo la valutazione media}{figure.caption.16}{}}
\newlabel{fig:mockup1@cref}{{[figure][14][]14}{[1][22][]22}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {Esplora Spiagge - Mobile (UC-04):} versione mobile dell'interfaccia B2C per la consultazione del catalogo spiagge da parte di customers e guests.}}{23}{figure.caption.17}\protected@file@percent }
\newlabel{fig:mockup2}{{15}{23}{\textbf {Esplora Spiagge - Mobile (UC-04):} versione mobile dell'interfaccia B2C per la consultazione del catalogo spiagge da parte di customers e guests}{figure.caption.17}{}}
\newlabel{fig:mockup2@cref}{{[figure][15][]15}{[1][22][]23}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \textbf  {Flusso di Prenotazione (UC-05):} interfaccia mobile per la creazione di una prenotazione. Evidenzia l'applicazione delle regole di dominio: controlli stringenti sulla capienza massima di parcheggi ed extra, e il calcolo in tempo reale del prezzo totale (tramite \texttt  {PriceCalculator}).}}{23}{figure.caption.17}\protected@file@percent }
\newlabel{fig:mockup3}{{16}{23}{\textbf {Flusso di Prenotazione (UC-05):} interfaccia mobile per la creazione di una prenotazione. Evidenzia l'applicazione delle regole di dominio: controlli stringenti sulla capienza massima di parcheggi ed extra, e il calcolo in tempo reale del prezzo totale (tramite \texttt {PriceCalculator})}{figure.caption.17}{}}
\newlabel{fig:mockup3@cref}{{[figure][16][]16}{[1][22][]23}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces \textbf  {Le Mie Prenotazioni e Recensioni (UC-06 \& UC-07):} dashboard mobile del customer. La UI riflette visivamente gli stati della prenotazione (\texttt  {PENDING} e \texttt  {CONFIRMED}). Viene inoltre mostrato il pulsante "Lascia una recensione", sbloccato dal backend esclusivamente per i soggiorni passati.}}{23}{figure.caption.17}\protected@file@percent }
\newlabel{fig:mockup4}{{17}{23}{\textbf {Le Mie Prenotazioni e Recensioni (UC-06 \& UC-07):} dashboard mobile del customer. La UI riflette visivamente gli stati della prenotazione (\texttt {PENDING} e \texttt {CONFIRMED}). Viene inoltre mostrato il pulsante "Lascia una recensione", sbloccato dal backend esclusivamente per i soggiorni passati}{figure.caption.17}{}}
\newlabel{fig:mockup4@cref}{{[figure][17][]17}{[1][22][]23}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces \textbf  {Dashboard Prenotazioni Owner (UC-05-1a \& UC-06):} interfaccia desktop B2B. Mostra la lista delle richieste in attesa con i pulsanti per l'approvazione/rifiuto e il bottone per avviare la "Prenotazione Telefonica Manuale" (che supporta dati chiamante slegati dall'ID cliente).}}{24}{figure.caption.18}\protected@file@percent }
\newlabel{fig:mockup5}{{18}{24}{\textbf {Dashboard Prenotazioni Owner (UC-05-1a \& UC-06):} interfaccia desktop B2B. Mostra la lista delle richieste in attesa con i pulsanti per l'approvazione/rifiuto e il bottone per avviare la "Prenotazione Telefonica Manuale" (che supporta dati chiamante slegati dall'ID cliente)}{figure.caption.18}{}}
\newlabel{fig:mockup5@cref}{{[figure][18][]18}{[1][23][]24}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces \textbf  {Gestione Stagioni e Prezzi (UC-14):} Il mockup dimostra l'imposizione delle regole di business del dominio: un avviso di errore per date sovrapposte (\textit  {overlap check}) e campi prezzo resi graficamente disabilitati (\textit  {sola lettura}) per garantirne l'immutabilità mentre la stagione è attiva.}}{24}{figure.caption.19}\protected@file@percent }
\newlabel{fig:mockup6}{{19}{24}{\textbf {Gestione Stagioni e Prezzi (UC-14):} Il mockup dimostra l'imposizione delle regole di business del dominio: un avviso di errore per date sovrapposte (\textit {overlap check}) e campi prezzo resi graficamente disabilitati (\textit {sola lettura}) per garantirne l'immutabilità mentre la stagione è attiva}{figure.caption.19}{}}
\newlabel{fig:mockup6@cref}{{[figure][19][]19}{[1][24][]24}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces \textbf  {Gestione Zone e Layout (UC-15):} strumento di mappatura della spiaggia. La figura evidenzia il blocco logico applicato alle zone già associate a una stagione, impedendone la modifica strutturale a tutela dell'integrità dei dati.}}{25}{figure.caption.20}\protected@file@percent }
\newlabel{fig:mockup7}{{20}{25}{\textbf {Gestione Zone e Layout (UC-15):} strumento di mappatura della spiaggia. La figura evidenzia il blocco logico applicato alle zone già associate a una stagione, impedendone la modifica strutturale a tutela dell'integrità dei dati}{figure.caption.20}{}}
\newlabel{fig:mockup7@cref}{{[figure][20][]20}{[1][24][]25}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces \textbf  {Dashboard di Moderazione Admin (UC-18 \& UC-19):} interfaccia desktop riservata agli admins. Mostra la tabella delle segnalazioni evidenziando il comportamento polimorfico del ban implementato nel backend (scelta tra \textit  {app ban} globale e \textit  {beach ban} selettivo).}}{25}{figure.caption.21}\protected@file@percent }
\newlabel{fig:mockup8}{{21}{25}{\textbf {Dashboard di Moderazione Admin (UC-18 \& UC-19):} interfaccia desktop riservata agli admins. Mostra la tabella delle segnalazioni evidenziando il comportamento polimorfico del ban implementato nel backend (scelta tra \textit {app ban} globale e \textit {beach ban} selettivo)}{figure.caption.21}{}}
