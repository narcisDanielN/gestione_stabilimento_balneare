\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces \textbf  {Esplora Spiagge - Desktop (UC-04):} interfaccia desktop per la ricerca nel catalogo. La vista interroga in sola lettura (CQRS tramite la \texttt  {BeachCatalogQuery}) il database, mostrando esclusivamente le spiagge in stato \textit  {ATTIVO} ed esponendo la valutazione media.}}{27}{figure.caption.23}\protected@file@percent }
\newlabel{fig:mockup1}{{18}{27}{\textbf {Esplora Spiagge - Desktop (UC-04):} interfaccia desktop per la ricerca nel catalogo. La vista interroga in sola lettura (CQRS tramite la \texttt {BeachCatalogQuery}) il database, mostrando esclusivamente le spiagge in stato \textit {ATTIVO} ed esponendo la valutazione media}{figure.caption.23}{}}
\newlabel{fig:mockup1@cref}{{[figure][18][]18}{[1][27][]27}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces \textbf  {Esplora Spiagge - Mobile (UC-04):} versione mobile dell'interfaccia B2C per la consultazione del catalogo spiagge da parte di customers e guests.}}{28}{figure.caption.24}\protected@file@percent }
\newlabel{fig:mockup2}{{19}{28}{\textbf {Esplora Spiagge - Mobile (UC-04):} versione mobile dell'interfaccia B2C per la consultazione del catalogo spiagge da parte di customers e guests}{figure.caption.24}{}}
\newlabel{fig:mockup2@cref}{{[figure][19][]19}{[1][27][]28}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces \textbf  {Flusso di Prenotazione (UC-05):} interfaccia mobile per la creazione di una prenotazione. Evidenzia l'applicazione delle regole di dominio: controlli stringenti sulla capienza massima di parcheggi ed extra, e il calcolo in tempo reale del prezzo totale (tramite \texttt  {PriceCalculator}).}}{28}{figure.caption.24}\protected@file@percent }
\newlabel{fig:mockup3}{{20}{28}{\textbf {Flusso di Prenotazione (UC-05):} interfaccia mobile per la creazione di una prenotazione. Evidenzia l'applicazione delle regole di dominio: controlli stringenti sulla capienza massima di parcheggi ed extra, e il calcolo in tempo reale del prezzo totale (tramite \texttt {PriceCalculator})}{figure.caption.24}{}}
\newlabel{fig:mockup3@cref}{{[figure][20][]20}{[1][27][]28}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces \textbf  {Le Mie Prenotazioni e Recensioni (UC-06 \& UC-07):} dashboard mobile del customer. La UI riflette visivamente gli stati della prenotazione (\texttt  {PENDING} e \texttt  {CONFIRMED}). Viene inoltre mostrato il pulsante "Lascia una recensione", sbloccato dal backend esclusivamente per i soggiorni passati.}}{28}{figure.caption.24}\protected@file@percent }
\newlabel{fig:mockup4}{{21}{28}{\textbf {Le Mie Prenotazioni e Recensioni (UC-06 \& UC-07):} dashboard mobile del customer. La UI riflette visivamente gli stati della prenotazione (\texttt {PENDING} e \texttt {CONFIRMED}). Viene inoltre mostrato il pulsante "Lascia una recensione", sbloccato dal backend esclusivamente per i soggiorni passati}{figure.caption.24}{}}
\newlabel{fig:mockup4@cref}{{[figure][21][]21}{[1][27][]28}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces \textbf  {Dashboard Prenotazioni Owner (UC-05-1a \& UC-06):} interfaccia desktop B2B. Mostra la lista delle richieste in attesa con i pulsanti per l'approvazione/rifiuto e il bottone per avviare la "Prenotazione Telefonica Manuale" (che supporta dati chiamante slegati dall'ID cliente).}}{29}{figure.caption.25}\protected@file@percent }
\newlabel{fig:mockup5}{{22}{29}{\textbf {Dashboard Prenotazioni Owner (UC-05-1a \& UC-06):} interfaccia desktop B2B. Mostra la lista delle richieste in attesa con i pulsanti per l'approvazione/rifiuto e il bottone per avviare la "Prenotazione Telefonica Manuale" (che supporta dati chiamante slegati dall'ID cliente)}{figure.caption.25}{}}
\newlabel{fig:mockup5@cref}{{[figure][22][]22}{[1][28][]29}}
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces \textbf  {Gestione Stagioni e Prezzi (UC-14):} Il mockup dimostra l'imposizione delle regole di business del dominio: un avviso di errore per date sovrapposte (\textit  {overlap check}) e campi prezzo resi graficamente disabilitati (\textit  {sola lettura}) per garantirne l'immutabilità mentre la stagione è attiva.}}{29}{figure.caption.26}\protected@file@percent }
\newlabel{fig:mockup6}{{23}{29}{\textbf {Gestione Stagioni e Prezzi (UC-14):} Il mockup dimostra l'imposizione delle regole di business del dominio: un avviso di errore per date sovrapposte (\textit {overlap check}) e campi prezzo resi graficamente disabilitati (\textit {sola lettura}) per garantirne l'immutabilità mentre la stagione è attiva}{figure.caption.26}{}}
\newlabel{fig:mockup6@cref}{{[figure][23][]23}{[1][29][]29}}
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces \textbf  {Gestione Zone e Layout (UC-15):} strumento di mappatura della spiaggia. La figura evidenzia il blocco logico applicato alle zone già associate a una stagione, impedendone la modifica strutturale a tutela dell'integrità dei dati.}}{30}{figure.caption.27}\protected@file@percent }
\newlabel{fig:mockup7}{{24}{30}{\textbf {Gestione Zone e Layout (UC-15):} strumento di mappatura della spiaggia. La figura evidenzia il blocco logico applicato alle zone già associate a una stagione, impedendone la modifica strutturale a tutela dell'integrità dei dati}{figure.caption.27}{}}
\newlabel{fig:mockup7@cref}{{[figure][24][]24}{[1][29][]30}}
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces \textbf  {Dashboard di Moderazione Admin (UC-18 \& UC-19):} interfaccia desktop riservata agli admins. Mostra la tabella delle segnalazioni evidenziando il comportamento polimorfico del ban implementato nel backend (scelta tra \textit  {app ban} globale e \textit  {beach ban} selettivo).}}{30}{figure.caption.28}\protected@file@percent }
\newlabel{fig:mockup8}{{25}{30}{\textbf {Dashboard di Moderazione Admin (UC-18 \& UC-19):} interfaccia desktop riservata agli admins. Mostra la tabella delle segnalazioni evidenziando il comportamento polimorfico del ban implementato nel backend (scelta tra \textit {app ban} globale e \textit {beach ban} selettivo)}{figure.caption.28}{}}
